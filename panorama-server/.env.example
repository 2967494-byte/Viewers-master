# OHIF Panorama Server - Environment Variables
# Скопируйте этот файл в .env и заполните реальные значения

# ============================================
# Основные настройки сервера
# ============================================
PORT=3001
NODE_ENV=production

# ============================================
# OHIF Viewer настройки
# ============================================
OHIF_BUILD_PATH=/opt/ohif-panorama/source/platform/app/dist
OHIF_PUBLIC_URL=http://localhost:3000

# ============================================
# S3 Storage (Yandex Cloud, MinIO, AWS и т.д.)
# ============================================
# Credentials
S3_ACCESS_KEY_ID=your-access-key-here
S3_SECRET_ACCESS_KEY=your-secret-key-here

# S3 Configuration
S3_REGION=ru-msk
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BUCKET=your-bucket-name
S3_PREFIX=panorama/
S3_FORCE_PATH_STYLE=true

# ============================================
# Локальные директории
# ============================================
SCREENSHOTS_DIR=/opt/ohif-panorama/screenshots
DATA_DIR=/opt/ohif-panorama/data
LOG_DIR=/opt/ohif-panorama/logs

# ============================================
# Chromium Browser
# ============================================
CHROMIUM_PATH=/usr/bin/chromium-browser

# ============================================
# Параметры по умолчанию для панорамирования
# ============================================
DEFAULT_ROTATION_STEPS=36
DEFAULT_ANGLE_DELTA=10
DEFAULT_SCREENSHOT_WIDTH=1024
DEFAULT_SCREENSHOT_HEIGHT=768

# ============================================
# Логирование
# ============================================
LOG_LEVEL=INFO
VERBOSE_LOGGING=false

# ============================================
# Примеры конфигураций для разных сервисов
# ============================================

# Yandex Cloud S3:
# S3_REGION=ru-msk
# S3_ENDPOINT=https://storage.yandexcloud.net

# MinIO:
# S3_REGION=us-east-1
# S3_ENDPOINT=http://minio-server:9000
# S3_FORCE_PATH_STYLE=true

# AWS S3:
# S3_REGION=us-east-1
# S3_ENDPOINT=https://s3.amazonaws.com

# DigitalOcean Spaces:
# S3_REGION=nyc3
# S3_ENDPOINT=https://nyc3.digitaloceanspaces.com

# Alibaba OSS (with S3 API):
# S3_REGION=oss-cn-hangzhou
# S3_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
